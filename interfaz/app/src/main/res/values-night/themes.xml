        <item name="colorPrimary">@color/pulse_blue</item>
        <item name="colorPrimaryContainer">@color/pulse_blue</item>
        <item name="android:statusBarColor">@color/pulse_blue</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColor">#212121</item>
        <item name="android:textColorPrimary">#212121</item>
        <item name="android:textColorSecondary">#616161</item>
        <item name="android:textColorHint">#757575</item>
    </style>
</resources>
